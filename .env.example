# Copy to .env and fill in. Every variable is described in PRD.md §7.
# Never commit .env: it is listed in .gitignore.

# The database. Railway, Render and DigitalOcean inject this from their PostgreSQL;
# docker compose sets it for you.
DATABASE_URL=postgresql://zrw:zrw@localhost:5433/zrw

# The Zotero group to index, and a READ-ONLY key with access to it
# (zotero.org/settings/keys). The id is the number in the group's web address.
ZOTERO_GROUP_ID=
ZOTERO_API_KEY=

# OpenRouter: embeddings, reranking and answers. Give the key a credit limit.
OPENROUTER_API_KEY=

# Signs the browser cookie. Any long random string, e.g. `openssl rand -hex 32`.
SECRET_KEY=

# Optional; the defaults are the CLI's best measured configuration.
# LLM_MODEL=openai/gpt-6-luna
# EMBEDDING_MODEL=openai/text-embedding-3-small   # at most 2,000 dimensions
# RERANKER=voyageai/rerank-3-lite                  # or none
# TOP_K=7
# DAILY_SPEND_CAP_USD=5.00
# LOG_FORMAT=console
